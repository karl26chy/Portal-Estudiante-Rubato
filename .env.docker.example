# ==============================================================================
# VARIABLES DE ENTORNO PARA DOCKER
# Copia este archivo como .env.docker y completa los valores
# ==============================================================================

# Configuración del servidor
PORT=5000
NODE_ENV=production

# Base de datos MySQL
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rubato_secret
DB_NAME=rubato_db

# Seguridad JWT (obligatoria)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_aleatorio
JWT_EXPIRES_IN=24h

# Cifrado AES-256-CBC (obligatorias, en hexadecimal)
# Clave (64 caracteres): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IV (32 caracteres):    node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
AES_SECRET_KEY=cambia_esto_por_una_clave_hex_de_64_caracteres
AES_IV=cambia_esto_por_un_iv_hex_de_32_caracteres
