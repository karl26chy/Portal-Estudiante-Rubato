# ==============================================================================
# VARIABLES DE ENTORNO DEL BACKEND (PLANTILLA EJEMPLO)
# Copia este archivo como .env y completa los valores correspondientes
# ==============================================================================

# Configuración del Servidor Express
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=rubato_db
DB_CONNECTION_LIMIT=10

# Configuración de CORS
CORS_ORIGIN=http://localhost:3000

# MODO MOCK (PRUEBAS SIN BASE DE DATOS)
# Si MOCK_MODE=true, el backend usará datos en memoria y no intentará conectar a MySQL.
# Por defecto y en producción debe estar en 'false' o ausente.
MOCK_MODE=false
