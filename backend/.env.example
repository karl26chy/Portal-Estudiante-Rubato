# ==============================================================================
# VARIABLES DE ENTORNO DEL BACKEND (PLANTILLA EJEMPLO)
# Copia este archivo como .env y completa los valores correspondientes
# ==============================================================================

# Configuración del Servidor Express
PORT=5000
NODE_ENV=development

# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1978
DB_NAME=rubato_db

# Seguridad JWT (obligatoria: el servidor no arranca sin ella)
# Genera un valor aleatorio, p. ej.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_aleatorio
JWT_EXPIRES_IN=24h

# Cifrado AES-256-CBC de credenciales (obligatorias, en hexadecimal)
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  (clave, 64 chars)
#             node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"  (IV, 32 chars)
AES_SECRET_KEY=cambia_esto_por_una_clave_hex_de_64_caracteres
AES_IV=cambia_esto_por_un_iv_hex_de_32_caracteres

# MODO MOCK (PRUEBAS SIN BASE DE DATOS)
# Si MOCK_MODE=true, el backend usará datos en memoria y no intentará conectar a MySQL.
# Por defecto y en producción debe estar en 'false' o ausente.
MOCK_MODE=false
