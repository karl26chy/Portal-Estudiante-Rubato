# ==============================================================================
# VARIABLES DE ENTORNO PARA DOCKER
# Copia este archivo como .env.docker y completa los valores
# ==============================================================================

# Configuración del servidor
PORT=5000
NODE_ENV=production

# Base de datos MySQL
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rubato_secret
DB_NAME=rubato_db

# Seguridad JWT (obligatoria)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=35691ed8004d918b0677475e005b2699235bfa8d723c4865f89c98a0d6bcb682
JWT_EXPIRES_IN=24h

# Cifrado AES-256-CBC (obligatorias, en hexadecimal)
# Clave (64 caracteres): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IV (32 caracteres):    node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
AES_SECRET_KEY=d8b8916b5e94e8d56089930c483532c0443cd0c857ee7cf9c859264c3e3c094a
AES_IV=31380324b5466298bda356a42e6e1648
